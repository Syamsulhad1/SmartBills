# Salin file ini menjadi `.env` lalu isi nilainya.
# JANGAN commit file `.env` yang berisi kredensial asli.

# Application
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/smartbills
PGHOST=localhost
PGPORT=5432
PGDATABASE=smartbills
PGUSER=postgres
PGPASSWORD=

# Auth
JWT_SECRET=change-me
JWT_EXPIRES_IN=1d
BCRYPT_SALT_ROUNDS=10

# Layanan AI / OCR (isi sesuai provider yang dipilih)
AI_API_KEY=
AI_MODEL=
OCR_API_KEY=

# CORS (pisahkan dengan koma bila lebih dari satu origin)
CORS_ORIGIN=http://localhost:5173
