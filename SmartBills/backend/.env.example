# Salin file ini menjadi `.env` lalu isi nilainya.
# JANGAN commit file `.env` yang berisi kredensial asli.

# Application
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smartbills
DB_USER=postgres
DB_PASSWORD=

# Opsional: gunakan ini jika ingin memakai connection string.
# Jika diisi, DATABASE_URL akan dipakai menggantikan DB_HOST/DB_PORT/DB_NAME/DB_USER/DB_PASSWORD.
# DATABASE_URL=postgresql://postgres:password@localhost:5432/smartbills

# Auth
JWT_SECRET=change-me
JWT_EXPIRES_IN=1d
BCRYPT_SALT_ROUNDS=10

# Layanan AI / OCR (isi sesuai provider yang dipilih)
AI_API_KEY=
AI_MODEL=
OCR_API_KEY=
