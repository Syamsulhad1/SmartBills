# Salin file ini menjadi `.env` lalu isi nilainya.
# JANGAN commit file `.env` yang berisi kredensial asli.

# Application
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Private receipt storage for local development. Files are not served publicly.
UPLOAD_DIR=uploads

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smartbills
DB_USER=postgres
DB_PASSWORD=

# Opsional: gunakan ini jika ingin memakai connection string.
# Jika diisi, DATABASE_URL akan dipakai menggantikan DB_HOST/DB_PORT/DB_NAME/DB_USER/DB_PASSWORD.
# DATABASE_URL=postgresql://postgres:password@localhost:5432/smartbills

# Auth
JWT_SECRET=change-me
JWT_EXPIRES_IN=1d
BCRYPT_SALT_ROUNDS=10

# Layanan AI / OCR (isi sesuai provider yang dipilih)
AI_API_KEY=
AI_MODEL=gemini-3.5-flash-lite
# OCR lokal menggunakan Tesseract; backend mengakses service terpisah di port 8080.
OCR_SERVICE_URL=http://localhost:8080
OCR_SERVICE_TOKEN=generate-a-random-secret-with-at-least-32-characters
OCR_LOCAL_PORT=8080
